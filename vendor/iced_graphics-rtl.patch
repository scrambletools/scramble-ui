     fn grapheme_position(&self, line: usize, index: usize) -> Option<Point> {
         use unicode_segmentation::UnicodeSegmentation;
 
+        // prev: the cursor before the grapheme at `index`, in either
+        // direction. The glyphs are in visual order, so the grapheme is
