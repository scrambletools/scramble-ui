+/// prev: whether `value` reads right to left, by its first letter with a
+/// direction.
+fn right_to_left(value: &Value) -> bool {
+    value
+        .to_string()
+        .chars()
+        .find_map(|c| {
+            let code = c as u32;
+            if matches!(
+                code,
+                0x0590..=0x08FF
+                    | 0xFB1D..=0xFDFF
+                    | 0xFE70..=0xFEFF
+                    | 0x10800..=0x10FFF
+                    | 0x1E800..=0x1EFFF
+            ) {
+                Some(true)
+            } else if c.is_alphabetic() {
+                Some(false)
+            } else {
+                None
+            }
+        })
+        .unwrap_or(false)
+}
+
+/// prev: the cursor position at the text's left edge, for presses left of
+/// the text: its start, or its end in right to left text.
+fn left_edge(value: &Value, is_secure: bool) -> usize {
+    if !is_secure && right_to_left(value) {
+        value.len()
+    } else {
+        0
+    }
+}
+
+/// prev: the arrow key that moves the cursor the way it points: in right to
+/// left text, logically backwards is to the right.
+fn visual_arrows(key: &keyboard::Key, value: &Value) -> keyboard::Key {
+    let right_to_left = right_to_left(value);
+    match key.as_ref() {
+        keyboard::Key::Named(key::Named::ArrowLeft) if right_to_left => {
+            keyboard::Key::Named(key::Named::ArrowRight)
+        }
+        keyboard::Key::Named(key::Named::ArrowRight) if right_to_left => {
+            keyboard::Key::Named(key::Named::ArrowLeft)
+        }
+        _ => key.clone(),
+    }
+}
